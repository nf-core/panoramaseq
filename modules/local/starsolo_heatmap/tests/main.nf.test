nextflow_process {

    name "Test Process STARSOLO_HEATMAP"
    script "../main.nf"
    process "STARSOLO_HEATMAP"

    tag "modules"
    tag "modules_local"
    tag "starsolo_heatmap"

    test("starsolo_heatmap - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("test.Solo.out", checkIfExists: false)
                ]
                input[1] = [
                    [ id:'test' ],
                    file("test_barcode_mapping.tsv", checkIfExists: false)
                ]
                input[2] = file("barcodes_coords.csv", checkIfExists: false)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
