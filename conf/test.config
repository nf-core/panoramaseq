/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/panoramaseq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    
    // Override STAR CPU requirements for testing
    withName: 'STAR_ALIGN' {
        cpus = 4
        memory = 8.GB
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data from nf-core test repository
    input  = 'https://raw.githubusercontent.com/nf-core/test-datasets/panoramaseq/samplesheet/samplesheet.csv'

    // Subsample reads for faster testing
    sample_size = 400000

    // Use nf-core reference files for genome generation
    fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta'
    star_gtf = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.gtf'

    // Don't use igenomes or pre-built indices - generate from fasta/gtf
    genome = null

    // Test-specific resource limits
    max_memory = '6.GB'
    max_cpus = 2
    max_time = '6.h'
}
