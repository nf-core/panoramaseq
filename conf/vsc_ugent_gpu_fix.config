// Local override for vsc_ugent GPU configuration
// This fixes GPU job submission issues specific to your HPC setup

// Configure executor to use real sbatch binary
executor {
    submitCommandPath = '/usr/bin/sbatch'
}

process {
    withLabel: use_gpu {
        // Override the nf-core config to use correct GPU settings
        // Clear queue to avoid partition conflicts when routing to accelgor
        queue = { null }
        beforeScript = 'module load CUDA/12.6.0'
        // Use SLURM syntax since we're using /usr/bin/sbatch directly
        clusterOptions = { '--gres=gpu:1 --clusters=accelgor' }
        containerOptions = '--nv'
        cpus = 4
        memory = 16.GB
        time = 12.h  // Increased from 4h to accommodate QUIK compilation + runtime
    }
}
