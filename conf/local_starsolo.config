// Local configuration for STARsolo testing with adequate resources
executor {
    cpus = 12
    memory = '80 GB'
}

process {
    resourceLimits = [
        cpus: 12,
        memory: '80 GB',
        time: '4 h'
    ]
}

// Use scratch directory for Singularity cache to avoid home directory quota
singularity {
    cacheDir = '/kyukon/scratch/gent/vo/000/gvo00027/vsc44685/singularity_cache'
}

apptainer {
    cacheDir = '/kyukon/scratch/gent/vo/000/gvo00027/vsc44685/singularity_cache'
}

