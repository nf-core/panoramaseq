/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    //cutadapt trim1 (nf-core module)
    withName: 'CUTADAPT' {
        ext.args = '-q 10 -a T{16} --minimum-length 25 --pair-filter=first --overlap 8 -e 0.1'
        ext.prefix = { "${meta.id}.cutadapt" }
    }
    //cutadapt trim2 (advanced, R2-only, piped)
    withName: CUTADAPT_ADV {
        ext.args = '--quiet -e 0.15 -O 8 -m 25 -A AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC --pair-filter=any --action=trim --cores=2 --interleaved --trim-n --nextseq-trim=20 -j 2'
        ext.prefix = { "${meta.id}.cutadapt.adv" }
    }
    //cutadapt trim2 (advanced, R2-only, piped)
    withName: CUTADAPT_ADV_PIPE {
        ext.prefix = { "${meta.id}.cutadapt.adv" }
    }
    //seqtk
    withName: SEQTK_SAMPLE {
        ext.args = '-s100'
        ext.prefix = { "${meta.id}.sampled" }
    }
    // UMITOOLS_EXTRACT
    withName: UMITOOLS_EXTRACT {
        ext.args   = { [
                params.umitools_extract_method                  ? "--extract-method=${params.umitools_extract_method}" : '',
                params.umitools_bc_pattern                      ? "--bc-pattern='${params.umitools_bc_pattern}'" : '',
                params.umitools_bc_pattern2 && !meta.single_end ? "--bc-pattern2='${params.umitools_bc_pattern2}'" : '',
                params.umitools_umi_separator                   ? "--umi-separator='${params.umitools_umi_separator}'" : ''
        ].join(' ').trim() }
    }
    // QUIK barcode calling - runtime compilation with flexible barcode lengths
    // Uses local container: containers/quik_runtime_compile.sif
    // Parameters derived from starsolo_cb_len, starsolo_umi_len, and read_structure
    withName: 'QUIK_BARCODE_CALLING' {
        ext.prefix = { "${meta.id}.quik" }
        publishDir = [
            path: { "${params.outdir}/quik" },
            mode: params.publish_dir_mode,
            pattern: "*.{fastq.gz,txt}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}.assigned_sorted" }
    }
    //star alignment (nf-core module)
    withName: 'STAR_ALIGN' {
        ext.args = [
            '--outFilterType BySJout',
            '--outSAMunmapped Within',
            '--outFilterMultimapNmax 200',
            '--alignSJoverhangMin 8',
            '--alignSJDBoverhangMin 1',
            '--outFilterMismatchNmax 999',
            '--outFilterMismatchNoverLmax 0.6',
            '--alignIntronMin 20',
            '--alignIntronMax 1000000',
            '--alignMatesGapMax 1000000',
            '--limitOutSJcollapsed 5000000',
            '--limitIObufferSize 200000000 200000000',
            '--outSAMattributes NH HI NM MD',
            '--outSAMtype BAM SortedByCoordinate',
            '--limitBAMsortRAM 2000000000',
            '--readFilesCommand zcat'
        ].join(' ').trim()
        ext.prefix = { "${meta.id}.star" }
        publishDir = [
            path: { "${params.outdir}/star" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: index1 {
        publishDir = [
            path: { "${params.outdir}/star" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: index2 {
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: UMI_count {
        publishDir = [
            path: { "${params.outdir}/UMI_counts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ANNDATA_MAKEH5AD {
        publishDir = [
            path: { "${params.outdir}/h5ad/intermediate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: false // Don't publish intermediate H5AD files - only publish validated ones
        ]
        // Fail if all input files are empty, but this shouldn't happen in merged mode
        // as we filter empty files before processing
    }

    withName: ANNDATA_MAKEH5AD_SINGLE {
        publishDir = [
            path: { "${params.outdir}/h5ad/intermediate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: false // Don't publish intermediate H5AD files - only publish validated ones
        ]
        // In single mode, ignore errors from empty files - allows pipeline to continue
        // with samples that have valid data
        errorStrategy = 'ignore'
    }

    withName: ANNDATA_CHECKH5AD {
        publishDir = [
            path: { "${params.outdir}/h5ad" },
            mode: params.publish_dir_mode,
            pattern: "*.{h5ad,log}",  // Publish both H5AD and log files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // STARsolo workflow-specific configurations
    //
    withName: '.*:QUIK_STARSOLO' {
        label = 'use_gpu'
        publishDir = [
            path: { "${params.outdir}/quik_starsolo" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:REORDER_R1_FOR_STARSOLO' {
        publishDir = [
            path: { "${params.outdir}/reorder_r1" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:REMAP_BARCODES_FOR_STARSOLO' {
        // Note: barcode_start and barcode_length are auto-derived from read_structure and starsolo params
        // Defaults: barcode_start=0, barcode_length=starsolo_cb_len, umi_length=starsolo_umi_len
        ext.synthetic_length = 25   // Synthetic barcode length (must be ≤31bp for STARsolo)
        publishDir = [
            path: { "${params.outdir}/barcode_remapping" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:STARSOLO' {
        cpus = 12
        ext.args = { meta ->
            // STARsolo parameters for synthetic 25bp barcodes (after QUIK remapping)
            // Original barcodes are remapped to synthetic 25bp format to avoid STARsolo 31bp limit
            def cb_start  = 1      // Synthetic barcode at position 1
            def cb_len    = 25     // Synthetic barcode length (remapped from original)
            def umi_start = 26     // UMI starts after 25bp synthetic barcode
            def umi_len   = params.starsolo_umi_len  // UMI length from params
            
            return [
                "--soloCBstart ${cb_start}",
                "--soloCBlen ${cb_len}",
                "--soloUMIstart ${umi_start}",
                "--soloUMIlen ${umi_len}",
                "--soloCBmatchWLtype ${params.starsolo_match_wl_type}",
                "--soloStrand ${params.starsolo_strand}",
                "--soloFeatures ${params.starsolo_features}",
                "--clip3pAdapterSeq ${params.starsolo_clip_3p_adapter}",
                "--clip3pAdapterMMp ${params.starsolo_clip_3p_mm}",
                '--outSAMattributes NH HI nM AS CR UR CB UB GX GN sS sQ sM',
                '--outSAMtype BAM SortedByCoordinate',
                "--outFilterMatchNmin ${params.starsolo_min_match_len}",
                "--outFilterMatchNminOverLread ${params.starsolo_min_match_frac}",
                "--limitOutSJcollapsed ${params.starsolo_sj_limit}"
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/starsolo/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:STARSOLO_TO_H5AD' {
        ext.feature_type = "GeneFull"
        publishDir = [
            path: { "${params.outdir}/h5ad" },
            mode: params.publish_dir_mode,
            pattern: "*.h5ad",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:STARSOLO_HEATMAP' {
        cpus = 12
        ext.metric = params.heatmap_metric ?: 'total_counts'
        ext.colormap = params.heatmap_colormap ?: 'viridis'
        ext.percentile = params.heatmap_percentile ?: 99.5
        ext.save_h5ad = params.heatmap_save_h5ad ?: false
        publishDir = [
            [
                path: { "${params.outdir}/heatmaps" },
                mode: params.publish_dir_mode,
                pattern: "*.{png,h5ad}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/heatmaps/data" },
                mode: params.publish_dir_mode,
                pattern: "*.{tsv,json}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    // ── Columba barcode rescue (optional) ────────────────────────────────────
    withName: '.*:COLUMBA_BUILD' {
        // Build step is lightweight; medium resources are sufficient.
        // Singularity: pre-built binaries are copied from the container image.
        // Conda/HPC:   params.columba_repo must point to a local Columba clone.
        publishDir = [
            path: { "${params.outdir}/columba/build" },
            mode: params.publish_dir_mode,
            pattern: "versions.yml",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BARCODE_TO_FASTA' {
        publishDir = [
            enabled: false  // intermediate file; not needed in final output
        ]
    }

    withName: '.*:COLUMBA_INDEX' {
        publishDir = [
            enabled: false  // intermediate index files; not needed in final output
        ]
    }

    withName: '.*:COLUMBA_ALIGN' {
        // Alignment is CPU-intensive; use all available cores.
        publishDir = [
            path: { "${params.outdir}/columba/align/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*_columba_stats.txt",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:COLUMBA_RESCUE_READS' {
        publishDir = [
            path: { "${params.outdir}/columba/rescue/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*_columba_rescue_stats.txt",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MERGE_RESCUED_READS' {
        publishDir = [
            enabled: false  // merged FASTQ/whitelist are consumed by downstream steps
        ]
    }
}
